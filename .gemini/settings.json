{
  "security": {
    "auth": {
      "selectedType": "gemini-api-key"
    }
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.config/agents/hooks/bash-guard.sh --no-ask",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
